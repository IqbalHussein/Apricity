{
  "name": "@apricity/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "cargo build --manifest-path ../../crates/apricity-ffi/Cargo.toml --target wasm32-unknown-unknown --release --features wasm && wasm-bindgen ../../target/wasm32-unknown-unknown/release/apricity_ffi.wasm --target web --out-dir ./src/wasm --out-name apricity_ffi",
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "e2e": "playwright test",
    "typecheck": "pnpm run build:wasm && tsc --noEmit"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.5.0",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@webgpu/types": "^0.1.69",
    "eslint": "^8.57.0",
    "eslint-plugin-solid": "^0.13.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^1.5.0"
  }
}
